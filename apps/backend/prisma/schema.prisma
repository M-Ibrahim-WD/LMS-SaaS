generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  INSTRUCTOR
  STUDENT
}

enum AdminPermission {
  VIEW_OVERVIEW
  REVIEW_TENANTS
  MANAGE_TENANTS
  REVIEW_STUDENTS
  REVIEW_INSTRUCTORS
  MANAGE_USERS
  REVIEW_COURSES
  REVIEW_PAYMENTS
  MANAGE_PLANS
  REVIEW_ADMINS
  HANDLE_SUPPORT
}

enum CourseStatus {
  DRAFT
  PUBLISHED
}

enum CourseLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum LessonType {
  VIDEO
  TEXT
  FILE
}

enum QuizQuestionType {
  MULTIPLE_CHOICE
}

enum AssignmentSubmissionStatus {
  PENDING_REVIEW
  REVIEWED
}

enum AssessmentScopeType {
  LESSON
  SECTION
  COURSE
}

enum QuizAttemptStatus {
  IN_PROGRESS
  SUBMITTED
  BLANK
}

enum PaymentMethodType {
  INSTAPAY
  VODAFONE_CASH
  ORANGE_CASH
  ETISALAT_CASH
  WE_CASH
  FAWRY
  BANK
  CUSTOM
  MADA
  KNET
  OMANNET
  APPLE_PAY
  STC_PAY
  GOOGLE_PAY
}

enum PaymentMethodCategory {
  MANUAL
  ONLINE
}

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum NotificationType {
  WELCOME
  INSTRUCTOR_JOINED
  PAYMENT_SUBMITTED
  PAYMENT_APPROVED
  PAYMENT_REJECTED
  ENROLLMENT_CREATED
  CERTIFICATE_ISSUED
  DIRECT_MESSAGE_RECEIVED
  SUPPORT_REPLY_RECEIVED
  SUPPORT_ASSIGNED
  SUPPORT_STATUS_CHANGED
  GROUP_MESSAGE_RECEIVED
  GROUP_ADDED
  INTERVIEW_SCHEDULED
  INTERVIEW_UPDATED
  INTERVIEW_COMPLETED
  CONTENT_SECURITY_ALERT
}

enum ProtectedContentEventType {
  MEDIA_SESSION_STARTED
  MEDIA_SESSION_ENDED
  TAB_HIDDEN
  FULLSCREEN_EXITED
  PRINT_ATTEMPT
  COPY_ATTEMPT
  CONTEXT_MENU_ATTEMPT
  INVALID_MEDIA_TOKEN
  SUSPICIOUS_SESSION_REGENERATION
}

enum ConversationKind {
  DIRECT
  SUPPORT
  GROUP
}

enum ConversationStatus {
  OPEN
  CLOSED
}

enum ConversationGroupScope {
  COURSE
  FOLLOWERS
  SELECTED
}

enum InterviewProvider {
  ZOOM
  GOOGLE_MEET
}

enum InterviewSessionStatus {
  DRAFT
  SCHEDULED
  COMPLETED
}

enum NotificationJobStatus {
  PENDING
  PROCESSED
  FAILED
}

enum SubscriptionState {
  TRIAL
  ACTIVE
  EXPIRED
  CANCELED
}

enum BillingPeriod {
  MONTHLY
  YEARLY
}

model Tenant {
  id        String   @id @default(uuid())
  name      String
  ownerId   String?  @unique @map("owner_id")
  planId    String?  @map("plan_id")
  inviteCode String  @unique @map("invite_code")
  isActive  Boolean  @default(true) @map("is_active")
  deactivatedAt DateTime? @map("deactivated_at")
  createdAt DateTime @default(now())

  plan    Plan?    @relation(fields: [planId], references: [id], onDelete: SetNull)
  owner   User?    @relation("TenantOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  users   User[]
  courses Course[]
  enrollments Enrollment[]
  paymentMethods PaymentMethod[]
  payments Payment[]
  certificates Certificate[]
  subscriptions TenantSubscription[]
  conversations Conversation[]

  @@index([isActive])
  @@index([planId])
}

model Plan {
  id                   String   @id @default(uuid())
  code                 String   @unique
  name                 String
  description          String?
  monthlyPrice         Float    @default(0) @map("monthly_price")
  yearlyPrice          Float    @default(0) @map("yearly_price")
  maxCourses           Int      @default(10) @map("max_courses")
  maxSectionsPerCourse Int      @default(10) @map("max_sections_per_course")
  maxLessonsPerSection Int      @default(20) @map("max_lessons_per_section")
  canPublishCourses    Boolean  @default(true) @map("can_publish_courses")
  canCreatePaidCourses Boolean  @default(true) @map("can_create_paid_courses")
  maxStudentsTotal     Int      @default(200) @map("max_students_total")
  maxStudentsPerCourse Int      @default(200) @map("max_students_per_course")
  canUseQuizzes        Boolean  @default(true) @map("can_use_quizzes")
  canUseAssignments    Boolean  @default(true) @map("can_use_assignments")
  canIssueCertificates Boolean  @default(true) @map("can_issue_certificates")
  canUseAnalytics      Boolean  @default(false) @map("can_use_analytics")
  canUseReviews        Boolean  @default(true) @map("can_use_reviews")
  maxStorageMb         Int      @default(512) @map("max_storage_mb")
  canUploadThumbnails  Boolean  @default(true) @map("can_upload_thumbnails")
  canUploadProfileImage Boolean @default(true) @map("can_upload_profile_image")
  canUseManualPayments Boolean  @default(true) @map("can_use_manual_payments")
  hasAdvancedAnalytics Boolean  @default(false) @map("has_advanced_analytics")
  hasOnlinePayments    Boolean  @default(false) @map("has_online_payments")
  maxAdminUsers        Int      @default(3) @map("max_admin_users")
  maxInstructorUsers   Int      @default(1) @map("max_instructor_users")
  isCore               Boolean  @default(false) @map("is_core")
  isActive             Boolean  @default(true) @map("is_active")
  isArchived           Boolean  @default(false) @map("is_archived")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  tenants Tenant[]
  subscriptions TenantSubscription[]

  @@index([isActive])
  @@index([isArchived])
}

model TenantSubscription {
  id             String            @id @default(uuid())
  tenantId        String            @map("tenant_id")
  planId          String            @map("plan_id")
  billingPeriod   BillingPeriod     @map("billing_period")
  state           SubscriptionState
  startsAt        DateTime          @map("starts_at")
  endsAt          DateTime          @map("ends_at")
  isTrial         Boolean           @default(false) @map("is_trial")
  adminActivated  Boolean           @default(false) @map("admin_activated")
  adminNote       String?           @map("admin_note")
  canceledAt      DateTime?         @map("canceled_at")
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan   Plan   @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([planId])
  @@index([tenantId, state])
  @@index([endsAt])
}

model User {
  id        String   @id @default(uuid())
  tenantId  String?  @map("tenant_id")
  email     String   @unique
  fullName  String
  bio       String?
  profileImage String? @map("profile_image")
  password  String
  role      UserRole
  isSuperAdmin Boolean @default(false) @map("is_super_admin")
  adminPermissions AdminPermission[] @default([])
  mustChangePassword Boolean @default(false) @map("must_change_password")
  isActive  Boolean  @default(true) @map("is_active")
  deactivatedAt DateTime? @map("deactivated_at")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant           Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  ownedTenant      Tenant?  @relation("TenantOwner")
  instructorCourses Course[] @relation("InstructorCourses")
  enrollments      Enrollment[]
  paymentMethods   PaymentMethod[] @relation("InstructorPaymentMethods")
  payments         Payment[]
  joinedInstructors StudentInstructor[] @relation("StudentInstructorStudent")
  followedByStudents StudentInstructor[] @relation("StudentInstructorInstructor")
  lessonCompletions LessonCompletion[]
  quizSubmissions QuizSubmission[]
  quizAttempts QuizAttempt[]
  assignmentSubmissions AssignmentSubmission[]
  certificates Certificate[]
  notifications Notification[]
  learnerStates CourseLearnerState[]
  courseReviews CourseReview[]
  adminAuditEntries AdminAuditLog[] @relation("AdminAuditActor")
  createdConversations Conversation[] @relation("ConversationCreator")
  directStudentConversations Conversation[] @relation("DirectStudentConversation")
  directInstructorConversations Conversation[] @relation("DirectInstructorConversation")
  requestedSupportConversations Conversation[] @relation("SupportRequesterConversation")
  managedGroupConversations Conversation[] @relation("GroupConversationInstructor")
  createdInterviewSessions CourseInterviewSession[] @relation("CourseInterviewCreator")
  interviewAttendances CourseInterviewAttendance[]
  conversationParticipants ConversationParticipant[]
  sentMessages Message[] @relation("ConversationMessageSender")
  supportAssignments SupportAssignment[] @relation("SupportAssignedAdmin")
  mediaSessions MediaSession[]
  protectedContentEvents ProtectedContentEvent[]

  @@index([tenantId])
  @@index([tenantId, role])
  @@index([isActive])
}

model AdminAuditLog {
  id            String   @id @default(uuid())
  actorUserId    String   @map("actor_user_id")
  action        String
  summary       String
  targetUserId   String?  @map("target_user_id")
  targetTenantId String?  @map("target_tenant_id")
  targetPlanId   String?  @map("target_plan_id")
  metadata      Json?
  createdAt     DateTime @default(now())

  actor User @relation("AdminAuditActor", fields: [actorUserId], references: [id], onDelete: Cascade)

  @@index([actorUserId])
  @@index([createdAt])
  @@index([action])
}

model CourseReview {
  id          String   @id @default(uuid())
  courseId     String   @map("course_id")
  studentId    String   @map("student_id")
  instructorId String   @map("instructor_id")
  rating      Int
  comment     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  course      Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  student     User   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([courseId, studentId])
  @@index([courseId])
  @@index([studentId])
  @@index([instructorId])
}

model StudentInstructor {
  id           String   @id @default(uuid())
  studentId    String   @map("student_id")
  instructorId String   @map("instructor_id")
  createdAt    DateTime @default(now())

  student    User @relation("StudentInstructorStudent", fields: [studentId], references: [id], onDelete: Cascade)
  instructor User @relation("StudentInstructorInstructor", fields: [instructorId], references: [id], onDelete: Cascade)

  @@unique([studentId, instructorId])
  @@index([studentId])
  @@index([instructorId])
}

model Course {
  id           String       @id @default(uuid())
  title        String
  description  String?
  thumbnailImage String?    @map("thumbnail_image")
  category     String?
  level        CourseLevel  @default(BEGINNER)
  isPaid       Boolean      @default(false) @map("is_paid")
  price        Float?
  status       CourseStatus @default(DRAFT)
  instructorId String       @map("instructor_id")
  tenantId     String       @map("tenant_id")
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  instructor User      @relation("InstructorCourses", fields: [instructorId], references: [id], onDelete: Cascade)
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sections   Section[]
  enrollments Enrollment[]
  payments   Payment[]
  lessonCompletions LessonCompletion[]
  quizzes Quiz[]
  assignments Assignment[]
  certificates Certificate[]
  learnerStates CourseLearnerState[]
  reviews CourseReview[]
  conversations Conversation[]
  interviewSessions CourseInterviewSession[]
  mediaSessions MediaSession[]
  protectedContentEvents ProtectedContentEvent[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([instructorId])
  @@index([category])
  @@index([level])
}

model Section {
  id       String   @id @default(uuid())
  title    String
  description String?
  courseId String   @map("course_id")
  order    Int

  course  Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons Lesson[]
  quizzes Quiz[]
  assignments Assignment[]

  @@index([courseId])
  @@unique([courseId, order])
}

model Lesson {
  id        String     @id @default(uuid())
  title     String
  content   String
  description String?
  type      LessonType
  sectionId String     @map("section_id")
  order     Int
  mediaAsset String?   @map("media_asset")
  mediaFileName String? @map("media_file_name")
  mediaContentType String? @map("media_content_type")

  section Section @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  completions LessonCompletion[]
  learnerStates CourseLearnerState[] @relation("LastViewedLesson")
  quizzes Quiz[]
  assignments Assignment[]
  mediaSessions MediaSession[]
  protectedContentEvents ProtectedContentEvent[]

  @@index([sectionId])
  @@unique([sectionId, order])
}

model LessonCompletion {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  lessonId  String   @map("lesson_id")
  courseId  String   @map("course_id")
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson  Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  course Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([userId])
  @@index([courseId])
  @@index([userId, courseId])
}

model Quiz {
  id           String   @id @default(uuid())
  courseId     String   @map("course_id")
  sectionId    String?  @map("section_id")
  lessonId     String?  @map("lesson_id")
  tenantId     String   @map("tenant_id")
  instructorId String   @map("instructor_id")
  scopeType    AssessmentScopeType @default(COURSE) @map("scope_type")
  title        String
  description  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  course      Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  section     Section?         @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  lesson      Lesson?          @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  questions   QuizQuestion[]
  submissions QuizSubmission[]
  attempts    QuizAttempt[]

  @@index([courseId])
  @@index([sectionId])
  @@index([lessonId])
  @@index([tenantId])
  @@index([instructorId])
  @@index([scopeType])
}

model QuizQuestion {
  id            String           @id @default(uuid())
  quizId         String           @map("quiz_id")
  question       String
  type           QuizQuestionType @default(MULTIPLE_CHOICE)
  options        Json
  correctAnswer  String          @map("correct_answer")
  order          Int

  quiz Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@index([quizId])
  @@unique([quizId, order])
}

model QuizSubmission {
  id            String   @id @default(uuid())
  quizId         String   @map("quiz_id")
  studentId      String   @map("student_id")
  tenantId       String   @map("tenant_id")
  answers        Json
  score          Float
  totalQuestions Int      @map("total_questions")
  createdAt      DateTime @default(now())

  quiz    Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)
  student User @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([quizId, studentId])
  @@index([tenantId])
  @@index([studentId])
}

model QuizAttempt {
  id             String            @id @default(uuid())
  quizId          String            @map("quiz_id")
  studentId       String            @map("student_id")
  tenantId        String            @map("tenant_id")
  status          QuizAttemptStatus @default(IN_PROGRESS)
  enteredAt       DateTime          @default(now()) @map("entered_at")
  submittedAt     DateTime?         @map("submitted_at")
  blankRecordedAt DateTime?         @map("blank_recorded_at")
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  quiz    Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)
  student User @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([quizId, studentId])
  @@index([tenantId])
  @@index([studentId])
  @@index([status])
}

model Assignment {
  id           String   @id @default(uuid())
  courseId     String   @map("course_id")
  sectionId    String?  @map("section_id")
  lessonId     String?  @map("lesson_id")
  tenantId     String   @map("tenant_id")
  instructorId String   @map("instructor_id")
  scopeType    AssessmentScopeType @default(COURSE) @map("scope_type")
  title        String
  description  String?
  instructions String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  course      Course                 @relation(fields: [courseId], references: [id], onDelete: Cascade)
  section     Section?               @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  lesson      Lesson?                @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  submissions AssignmentSubmission[]

  @@index([courseId])
  @@index([sectionId])
  @@index([lessonId])
  @@index([tenantId])
  @@index([instructorId])
  @@index([scopeType])
}

model AssignmentSubmission {
  id           String   @id @default(uuid())
  assignmentId String   @map("assignment_id")
  studentId    String   @map("student_id")
  tenantId     String   @map("tenant_id")
  content      String
  status       AssignmentSubmissionStatus @default(PENDING_REVIEW)
  feedback     String?
  score        Float?
  reviewedAt   DateTime? @map("reviewed_at")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student    User       @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, studentId])
  @@index([tenantId])
  @@index([studentId])
}

model CourseLearnerState {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  courseId     String   @map("course_id")
  lastLessonId String?  @map("last_lesson_id")
  updatedAt    DateTime @updatedAt

  user       User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course     Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lastLesson Lesson? @relation("LastViewedLesson", fields: [lastLessonId], references: [id], onDelete: SetNull)

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
}

model Certificate {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  courseId     String   @map("course_id")
  tenantId     String   @map("tenant_id")
  issuedAt     DateTime @default(now()) @map("issued_at")
  certificateNumber String @unique @map("certificate_number")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([tenantId])
  @@index([userId])
  @@index([courseId])
}

model Notification {
  id        String           @id @default(uuid())
  userId    String           @map("user_id")
  tenantId  String?          @map("tenant_id")
  type      NotificationType
  title     String
  message   String
  isRead    Boolean          @default(false) @map("is_read")
  createdAt DateTime         @default(now())
  readAt    DateTime?        @map("read_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobs NotificationJob[]

  @@index([userId])
  @@index([tenantId])
  @@index([userId, isRead])
}

model MediaSession {
  id             String   @id @default(uuid())
  tenantId       String   @map("tenant_id")
  userId         String   @map("user_id")
  courseId       String   @map("course_id")
  lessonId       String   @map("lesson_id")
  tokenHash      String   @unique @map("token_hash")
  expiresAt      DateTime @map("expires_at")
  lastAccessedAt DateTime? @map("last_accessed_at")
  createdAt      DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  events ProtectedContentEvent[]

  @@index([tenantId])
  @@index([userId])
  @@index([courseId])
  @@index([lessonId])
  @@index([expiresAt])
}

model ProtectedContentEvent {
  id             String                    @id @default(uuid())
  tenantId       String                    @map("tenant_id")
  userId         String                    @map("user_id")
  courseId       String                    @map("course_id")
  lessonId       String                    @map("lesson_id")
  mediaSessionId String?                   @map("media_session_id")
  eventType      ProtectedContentEventType @map("event_type")
  eventMetadata  Json?                     @map("event_metadata")
  createdAt      DateTime                  @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  course       Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lesson       Lesson       @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  mediaSession MediaSession? @relation(fields: [mediaSessionId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([userId])
  @@index([courseId])
  @@index([lessonId])
  @@index([mediaSessionId])
  @@index([eventType])
  @@index([createdAt])
}

model NotificationJob {
  id             String                @id @default(uuid())
  notificationId String                @map("notification_id")
  status         NotificationJobStatus @default(PENDING)
  channel        String                @default("IN_APP")
  payload        Json
  createdAt      DateTime              @default(now())
  processedAt    DateTime?             @map("processed_at")
  error          String?

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([notificationId])
}

model Conversation {
  id                String             @id @default(uuid())
  tenantId          String?            @map("tenant_id")
  kind              ConversationKind
  courseId          String?            @map("course_id")
  createdByUserId   String             @map("created_by_user_id")
  status            ConversationStatus @default(OPEN)
  directStudentId   String?            @map("direct_student_id")
  directInstructorId String?           @map("direct_instructor_id")
  requesterUserId   String?            @map("requester_user_id")
  groupScope        ConversationGroupScope? @map("group_scope")
  groupTitle        String?            @map("group_title")
  groupImage        String?            @map("group_image")
  groupInstructorId String?            @map("group_instructor_id")
  lastMessageAt     DateTime           @default(now()) @map("last_message_at")
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  tenant           Tenant?                    @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  course           Course?                    @relation(fields: [courseId], references: [id], onDelete: SetNull)
  createdBy        User                       @relation("ConversationCreator", fields: [createdByUserId], references: [id], onDelete: Cascade)
  directStudent    User?                      @relation("DirectStudentConversation", fields: [directStudentId], references: [id], onDelete: SetNull)
  directInstructor User?                      @relation("DirectInstructorConversation", fields: [directInstructorId], references: [id], onDelete: SetNull)
  requester        User?                      @relation("SupportRequesterConversation", fields: [requesterUserId], references: [id], onDelete: SetNull)
  groupInstructor  User?                      @relation("GroupConversationInstructor", fields: [groupInstructorId], references: [id], onDelete: SetNull)
  participants     ConversationParticipant[]
  messages         Message[]
  supportAssignment SupportAssignment?

  @@index([tenantId])
  @@index([kind, status])
  @@index([lastMessageAt])
  @@index([directStudentId, directInstructorId, status])
  @@index([requesterUserId, status])
  @@index([groupInstructorId, status])
}

model CourseInterviewSession {
  id                  String                 @id @default(uuid())
  courseId            String                 @map("course_id")
  provider            InterviewProvider
  title               String
  description         String?
  meetingUrl          String                 @map("meeting_url")
  scheduledAt         DateTime               @map("scheduled_at")
  durationMinutes     Int?                   @map("duration_minutes")
  status              InterviewSessionStatus @default(DRAFT)
  createdByInstructorId String               @map("created_by_instructor_id")
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  course             Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdByInstructor User   @relation("CourseInterviewCreator", fields: [createdByInstructorId], references: [id], onDelete: Cascade)
  attendances        CourseInterviewAttendance[]

  @@index([courseId, status])
  @@index([createdByInstructorId])
  @@index([scheduledAt])
}

model CourseInterviewAttendance {
  id          String   @id @default(uuid())
  interviewId String   @map("interview_id")
  studentId   String   @map("student_id")
  joinedAt    DateTime @default(now()) @map("joined_at")

  interview CourseInterviewSession @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  student   User                   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([interviewId, studentId])
  @@index([studentId])
  @@index([interviewId])
}

model ConversationParticipant {
  id             String   @id @default(uuid())
  conversationId String   @map("conversation_id")
  userId         String   @map("user_id")
  roleSnapshot   UserRole @map("role_snapshot")
  lastReadAt     DateTime? @map("last_read_at")
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
  @@index([conversationId])
}

model Message {
  id             String    @id @default(uuid())
  conversationId String    @map("conversation_id")
  senderUserId   String    @map("sender_user_id")
  body           String
  createdAt      DateTime  @default(now())
  editedAt       DateTime? @map("edited_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation("ConversationMessageSender", fields: [senderUserId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([senderUserId])
}

model SupportAssignment {
  id             String   @id @default(uuid())
  conversationId String   @unique @map("conversation_id")
  adminUserId    String   @map("admin_user_id")
  assignedAt     DateTime @default(now()) @map("assigned_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  admin        User         @relation("SupportAssignedAdmin", fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId])
}

model Enrollment {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  courseId  String   @map("course_id")
  tenantId  String   @map("tenant_id")
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([tenantId])
  @@index([userId, tenantId])
  @@index([courseId, tenantId])
}

model PaymentMethod {
  id           String                @id @default(uuid())
  instructorId String                @map("instructor_id")
  tenantId     String                @map("tenant_id")
  type         PaymentMethodType
  category     PaymentMethodCategory
  label        String
  details      String
  isActive     Boolean               @default(true) @map("is_active")
  isDeleted    Boolean               @default(false) @map("is_deleted")
  deletedAt    DateTime?             @map("deleted_at")
  createdAt    DateTime              @default(now())

  instructor User   @relation("InstructorPaymentMethods", fields: [instructorId], references: [id], onDelete: Cascade)
  tenant     Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payments   Payment[]

  @@index([tenantId])
  @@index([tenantId, isActive])
  @@index([tenantId, isDeleted])
  @@index([instructorId, tenantId])
  @@unique([instructorId, type, details, isDeleted])
}

model Payment {
  id        String        @id @default(uuid())
  userId    String        @map("user_id")
  courseId  String        @map("course_id")
  tenantId  String        @map("tenant_id")
  methodId  String        @map("method_id")
  amount    Float
  proof     String
  status    PaymentStatus @default(PENDING)
  createdAt DateTime      @default(now())

  user   User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  tenant Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  method PaymentMethod @relation(fields: [methodId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([userId, tenantId])
  @@index([courseId, tenantId])
  @@index([methodId, tenantId])
  @@index([status])
}
