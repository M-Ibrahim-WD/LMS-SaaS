{
  "name": "@lms/frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "set NEXT_DIST_DIR=.next-dev&& next dev -p 3000",
    "build": "set NEXT_DIST_DIR=.next-build&& next build",
    "start": "set NEXT_DIST_DIR=.next-build&& next start -p 3000",
    "lint": "tsc --noEmit -p tsconfig.lint.json",
    "format": "prettier --write \"**/*.{ts,tsx,css,md,json}\""
  },
  "dependencies": {
    "@tanstack/react-query": "^5.59.0",
    "next": "^15.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "prettier": "^3.3.3",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.2"
  }
}
